// Modelo Off-chain del prototipo de trazabilidad microcurricular - I.E. Nuevo Horizonte.
//
// Implementa tabla por tabla el modelo del Hito 2 (hito2/H2_04_Modelo_Datos_OffChain.sql).
// Los nombres de tablas y columnas son los mismos; los modelos Prisma usan PascalCase.
//
// Extensiones respecto del Hito 2 (justificadas en informes/H3_03):
//   E1 resultado_academico.codigo          referencia técnica estable (registro_id del dataset H2_02)
//   E2 evento_trazabilidad.resultado_verificacion  resultado explícito de la verificación (RF-22)
//   E3 evento_trazabilidad.error_detalle   diagnóstico cuando el envío a Fabric falla (RNF-14)
//   E4 tipo_actividad incluye TRABAJO     tipo presente en el dataset H2_02 y ausente en el catálogo H2
//
// Privacidad (RNF-06, RNF-07): la base solo contiene tokens seudónimos. La correspondencia
// token ↔ identidad real NO se almacena aquí; permanece bajo custodia institucional separada.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumeraciones (mismos valores que el SQL del Hito 2)
// ---------------------------------------------------------------------------

enum EstadoActivo {
  ACTIVO
  INACTIVO
}

enum EstadoPeriodo {
  PLANIFICADO
  ABIERTO
  CERRADO
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
  RETIRADO
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO
  INACTIVO
}

enum EstadoMatricula {
  VIGENTE
  RETIRADA
  TRASLADADA
  CERRADA
}

enum EstadoAsignacion {
  ACTIVA
  FINALIZADA
}

enum EstadoActividad {
  BORRADOR
  PUBLICADA
  CERRADA
  ANULADA
}

enum EstadoResultado {
  VIGENTE
  RECTIFICADO
  REVOCADO
}

enum TipoCambio {
  CREACION
  RECTIFICACION
  REVOCACION
  RESTAURACION
}

enum EstadoAsistencia {
  PRESENTE
  TARDANZA
  FALTA
  JUSTIFICADA
}

enum ObjetoTipo {
  RESULTADO
  ACTIVIDAD
  ASISTENCIA
}

enum EventoTipo {
  CREACION
  ACTUALIZACION
  RECTIFICACION
  VERIFICACION
  REVOCACION
}

enum EstadoEvento {
  PENDIENTE
  CONFIRMADO
  ERROR
}

enum ResultadoVerificacion {
  INTEGRO
  ALTERADO
  NO_VERIFICABLE
}

enum ValidacionBlockchain {
  VALIDA
  INVALIDA
  PENDIENTE
}

// ---------------------------------------------------------------------------
// Estructura institucional
// ---------------------------------------------------------------------------

model Institucion {
  id            BigInt       @id @default(autoincrement()) @map("institucion_id") @db.UnsignedBigInt
  codigo        String       @unique @db.VarChar(30)
  nombre        String       @db.VarChar(180)
  ciudad        String       @db.VarChar(100)
  estado        EstadoActivo @default(ACTIVO)
  creadoEn      DateTime     @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn DateTime     @default(now()) @updatedAt @map("actualizado_en") @db.Timestamp(0)

  periodos PeriodoAcademico[]
  areas    AreaCurricular[]
  grados   Grado[]

  @@map("institucion")
}

model PeriodoAcademico {
  id            BigInt        @id @default(autoincrement()) @map("periodo_id") @db.UnsignedBigInt
  institucionId BigInt        @map("institucion_id") @db.UnsignedBigInt
  codigo        String        @db.VarChar(30)
  nombre        String        @db.VarChar(100)
  fechaInicio   DateTime      @map("fecha_inicio") @db.Date
  fechaFin      DateTime      @map("fecha_fin") @db.Date
  estado        EstadoPeriodo @default(ABIERTO)

  institucion  Institucion         @relation(fields: [institucionId], references: [id], map: "fk_periodo_institucion")
  matriculas   Matricula[]
  asignaciones AsignacionDocente[]

  @@unique([institucionId, codigo], map: "uq_periodo")
  @@map("periodo_academico")
}

model AreaCurricular {
  id            BigInt       @id @default(autoincrement()) @map("area_id") @db.UnsignedBigInt
  institucionId BigInt       @map("institucion_id") @db.UnsignedBigInt
  codigo        String       @db.VarChar(30)
  nombre        String       @db.VarChar(120)
  estado        EstadoActivo @default(ACTIVO)

  institucion  Institucion         @relation(fields: [institucionId], references: [id], map: "fk_area_institucion")
  asignaciones AsignacionDocente[]

  @@unique([institucionId, codigo], map: "uq_area")
  @@map("area_curricular")
}

model Grado {
  id            BigInt @id @default(autoincrement()) @map("grado_id") @db.UnsignedBigInt
  institucionId BigInt @map("institucion_id") @db.UnsignedBigInt
  nivel         String @default("SECUNDARIA") @db.VarChar(40)
  numero        Int    @db.UnsignedTinyInt
  nombre        String @db.VarChar(60)

  institucion Institucion @relation(fields: [institucionId], references: [id], map: "fk_grado_institucion")
  secciones   Seccion[]

  @@unique([institucionId, nivel, numero], map: "uq_grado")
  @@map("grado")
}

model Seccion {
  id      BigInt  @id @default(autoincrement()) @map("seccion_id") @db.UnsignedBigInt
  gradoId BigInt  @map("grado_id") @db.UnsignedBigInt
  codigo  String  @db.VarChar(10)
  nombre  String? @db.VarChar(40)

  grado        Grado               @relation(fields: [gradoId], references: [id], map: "fk_seccion_grado")
  matriculas   Matricula[]
  asignaciones AsignacionDocente[]

  @@unique([gradoId, codigo], map: "uq_seccion")
  @@map("seccion")
}

// ---------------------------------------------------------------------------
// Personas seudonimizadas
// ---------------------------------------------------------------------------

/// Representación seudonimizada del estudiante. Sin nombre, DNI ni código institucional legible.
model Estudiante {
  id              BigInt           @id @default(autoincrement()) @map("estudiante_id") @db.UnsignedBigInt
  tokenEstudiante String           @unique @map("token_estudiante") @db.VarChar(40)
  estado          EstadoEstudiante @default(ACTIVO)
  creadoEn        DateTime         @default(now()) @map("creado_en") @db.Timestamp(0)

  matriculas Matricula[]

  @@map("estudiante")
}

/// Representación seudonimizada del docente.
model Docente {
  id           BigInt       @id @default(autoincrement()) @map("docente_id") @db.UnsignedBigInt
  tokenDocente String       @unique @map("token_docente") @db.VarChar(40)
  estado       EstadoActivo @default(ACTIVO)
  creadoEn     DateTime     @default(now()) @map("creado_en") @db.Timestamp(0)

  usuarios     Usuario[]
  asignaciones AsignacionDocente[]

  @@map("docente")
}

model Usuario {
  id             BigInt        @id @default(autoincrement()) @map("usuario_id") @db.UnsignedBigInt
  username       String        @unique @db.VarChar(80)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  docenteId      BigInt?       @map("docente_id") @db.UnsignedBigInt
  estado         EstadoUsuario @default(ACTIVO)
  ultimoAccesoEn DateTime?     @map("ultimo_acceso_en") @db.DateTime(0)
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamp(0)

  docente                Docente?             @relation(fields: [docenteId], references: [id], map: "fk_usuario_docente")
  roles                  UsuarioRol[]
  actividadesCreadas     ActividadAcademica[]
  resultadosRegistrados  ResultadoAcademico[]
  cambiosRealizados      HistorialResultado[]
  asistenciasRegistradas Asistencia[]
  eventos                EventoTrazabilidad[]

  @@map("usuario")
}

model Rol {
  id          Int     @id @default(autoincrement()) @map("rol_id") @db.UnsignedSmallInt
  codigo      String  @unique @db.VarChar(40)
  nombre      String  @db.VarChar(80)
  descripcion String? @db.VarChar(255)

  usuarios UsuarioRol[]

  @@map("rol")
}

model UsuarioRol {
  usuarioId  BigInt   @map("usuario_id") @db.UnsignedBigInt
  rolId      Int      @map("rol_id") @db.UnsignedSmallInt
  asignadoEn DateTime @default(now()) @map("asignado_en") @db.Timestamp(0)

  usuario Usuario @relation(fields: [usuarioId], references: [id], map: "fk_ur_usuario")
  rol     Rol     @relation(fields: [rolId], references: [id], map: "fk_ur_rol")

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

// ---------------------------------------------------------------------------
// Gestión académica
// ---------------------------------------------------------------------------

model Matricula {
  id             BigInt          @id @default(autoincrement()) @map("matricula_id") @db.UnsignedBigInt
  estudianteId   BigInt          @map("estudiante_id") @db.UnsignedBigInt
  periodoId      BigInt          @map("periodo_id") @db.UnsignedBigInt
  seccionId      BigInt          @map("seccion_id") @db.UnsignedBigInt
  estado         EstadoMatricula @default(VIGENTE)
  fechaMatricula DateTime?       @map("fecha_matricula") @db.Date

  estudiante  Estudiante           @relation(fields: [estudianteId], references: [id], map: "fk_matricula_estudiante")
  periodo     PeriodoAcademico     @relation(fields: [periodoId], references: [id], map: "fk_matricula_periodo")
  seccion     Seccion              @relation(fields: [seccionId], references: [id], map: "fk_matricula_seccion")
  resultados  ResultadoAcademico[]
  asistencias Asistencia[]

  @@unique([estudianteId, periodoId], map: "uq_matricula")
  @@map("matricula")
}

model AsignacionDocente {
  id        BigInt           @id @default(autoincrement()) @map("asignacion_id") @db.UnsignedBigInt
  docenteId BigInt           @map("docente_id") @db.UnsignedBigInt
  areaId    BigInt           @map("area_id") @db.UnsignedBigInt
  seccionId BigInt           @map("seccion_id") @db.UnsignedBigInt
  periodoId BigInt           @map("periodo_id") @db.UnsignedBigInt
  estado    EstadoAsignacion @default(ACTIVA)

  docente     Docente              @relation(fields: [docenteId], references: [id], map: "fk_asig_docente")
  area        AreaCurricular       @relation(fields: [areaId], references: [id], map: "fk_asig_area")
  seccion     Seccion              @relation(fields: [seccionId], references: [id], map: "fk_asig_seccion")
  periodo     PeriodoAcademico     @relation(fields: [periodoId], references: [id], map: "fk_asig_periodo")
  actividades ActividadAcademica[]
  asistencias Asistencia[]

  @@unique([docenteId, areaId, seccionId, periodoId], map: "uq_asignacion")
  @@map("asignacion_docente")
}

model TipoActividad {
  id          Int     @id @default(autoincrement()) @map("tipo_actividad_id") @db.UnsignedSmallInt
  codigo      String  @unique @db.VarChar(30)
  nombre      String  @db.VarChar(80)
  descripcion String? @db.VarChar(255)

  actividades ActividadAcademica[]

  @@map("tipo_actividad")
}

model ActividadAcademica {
  id              BigInt          @id @default(autoincrement()) @map("actividad_id") @db.UnsignedBigInt
  asignacionId    BigInt          @map("asignacion_id") @db.UnsignedBigInt
  tipoActividadId Int             @map("tipo_actividad_id") @db.UnsignedSmallInt
  codigo          String          @db.VarChar(40)
  titulo          String          @db.VarChar(180)
  descripcion     String?         @db.Text
  fechaActividad  DateTime        @map("fecha_actividad") @db.Date
  puntajeMaximo   Decimal         @default(20.00) @map("puntaje_maximo") @db.Decimal(6, 2)
  estado          EstadoActividad @default(PUBLICADA)
  creadoPor       BigInt          @map("creado_por") @db.UnsignedBigInt
  creadoEn        DateTime        @default(now()) @map("creado_en") @db.Timestamp(0)

  asignacion    AsignacionDocente    @relation(fields: [asignacionId], references: [id], map: "fk_act_asig")
  tipoActividad TipoActividad        @relation(fields: [tipoActividadId], references: [id], map: "fk_act_tipo")
  creador       Usuario              @relation(fields: [creadoPor], references: [id], map: "fk_act_usuario")
  resultados    ResultadoAcademico[]

  @@unique([asignacionId, codigo], map: "uq_actividad")
  @@index([fechaActividad, estado], map: "idx_actividad_fecha")
  @@map("actividad_academica")
}

/// Resultado académico detallado. Permanece Off-chain.
model ResultadoAcademico {
  id              BigInt          @id @default(autoincrement()) @map("resultado_id") @db.UnsignedBigInt
  /// E1: referencia técnica estable usada como objeto_ref On-chain (p. ej. REG-0001).
  codigo          String          @unique @db.VarChar(20)
  matriculaId     BigInt          @map("matricula_id") @db.UnsignedBigInt
  actividadId     BigInt          @map("actividad_id") @db.UnsignedBigInt
  versionActual   Int             @default(1) @map("version_actual") @db.UnsignedInt
  puntajeObtenido Decimal?        @map("puntaje_obtenido") @db.Decimal(6, 2)
  estado          EstadoResultado @default(VIGENTE)
  registradoPor   BigInt          @map("registrado_por") @db.UnsignedBigInt
  registradoEn    DateTime        @default(now()) @map("registrado_en") @db.DateTime(0)
  actualizadoEn   DateTime        @default(now()) @updatedAt @map("actualizado_en") @db.DateTime(0)

  matricula   Matricula            @relation(fields: [matriculaId], references: [id], map: "fk_res_matricula")
  actividad   ActividadAcademica   @relation(fields: [actividadId], references: [id], map: "fk_res_actividad")
  registrador Usuario              @relation(fields: [registradoPor], references: [id], map: "fk_res_usuario")
  historial   HistorialResultado[]

  @@unique([matriculaId, actividadId], map: "uq_resultado")
  @@index([actividadId, estado], map: "idx_resultado_actividad")
  @@index([matriculaId, estado], map: "idx_resultado_matricula")
  @@map("resultado_academico")
}

/// Historial detallado de cambios; respaldo operativo Off-chain.
model HistorialResultado {
  id              BigInt     @id @default(autoincrement()) @map("historial_id") @db.UnsignedBigInt
  resultadoId     BigInt     @map("resultado_id") @db.UnsignedBigInt
  version         Int        @db.UnsignedInt
  puntajeAnterior Decimal?   @map("puntaje_anterior") @db.Decimal(6, 2)
  puntajeNuevo    Decimal?   @map("puntaje_nuevo") @db.Decimal(6, 2)
  tipoCambio      TipoCambio @map("tipo_cambio")
  motivoCodigo    String?    @map("motivo_codigo") @db.VarChar(40)
  motivoDetalle   String?    @map("motivo_detalle") @db.VarChar(500)
  realizadoPor    BigInt     @map("realizado_por") @db.UnsignedBigInt
  realizadoEn     DateTime   @default(now()) @map("realizado_en") @db.DateTime(0)

  resultado ResultadoAcademico @relation(fields: [resultadoId], references: [id], map: "fk_hist_resultado")
  usuario   Usuario            @relation(fields: [realizadoPor], references: [id], map: "fk_hist_usuario")

  @@unique([resultadoId, version], map: "uq_historial_version")
  @@index([realizadoEn], map: "idx_historial_fecha")
  @@map("historial_resultado")
}

model Asistencia {
  id            BigInt           @id @default(autoincrement()) @map("asistencia_id") @db.UnsignedBigInt
  matriculaId   BigInt           @map("matricula_id") @db.UnsignedBigInt
  asignacionId  BigInt           @map("asignacion_id") @db.UnsignedBigInt
  fecha         DateTime         @db.Date
  estado        EstadoAsistencia
  registradoPor BigInt           @map("registrado_por") @db.UnsignedBigInt
  registradoEn  DateTime         @default(now()) @map("registrado_en") @db.DateTime(0)

  matricula  Matricula         @relation(fields: [matriculaId], references: [id], map: "fk_asis_matricula")
  asignacion AsignacionDocente @relation(fields: [asignacionId], references: [id], map: "fk_asis_asignacion")
  usuario    Usuario           @relation(fields: [registradoPor], references: [id], map: "fk_asis_usuario")

  @@unique([matriculaId, asignacionId, fecha], map: "uq_asistencia")
  @@index([fecha, estado], map: "idx_asistencia_fecha")
  @@map("asistencia")
}

// ---------------------------------------------------------------------------
// Vinculación On-chain / Off-chain
// ---------------------------------------------------------------------------

/// Cola/registro local de eventos destinados a blockchain.
model EventoTrazabilidad {
  /// UUID generado por el middleware; es también la clave de la evidencia en el ledger.
  id                    String                 @id @map("evento_id") @db.Char(36)
  objetoTipo            ObjetoTipo             @map("objeto_tipo")
  /// Referencia seudónima/código técnico, nunca nombre o DNI.
  objetoRef             String                 @map("objeto_ref") @db.VarChar(80)
  eventoTipo            EventoTipo             @map("evento_tipo")
  version               Int                    @db.UnsignedInt
  actorUsuarioId        BigInt                 @map("actor_usuario_id") @db.UnsignedBigInt
  actorRolCodigo        String                 @map("actor_rol_codigo") @db.VarChar(40)
  /// HMAC-SHA-256 del payload canónico; la clave permanece fuera de la blockchain.
  compromisoHmac        String                 @map("compromiso_hmac") @db.Char(64)
  compromisoAnterior    String?                @map("compromiso_anterior") @db.Char(64)
  estadoEvento          EstadoEvento           @default(PENDIENTE) @map("estado_evento")
  /// E2: resultado de la verificación (solo eventos VERIFICACION).
  resultadoVerificacion ResultadoVerificacion? @map("resultado_verificacion")
  /// E3: causa del último fallo de envío a Fabric.
  errorDetalle          String?                @map("error_detalle") @db.VarChar(500)
  creadoEn              DateTime               @default(now()) @map("creado_en") @db.DateTime(0)

  actor     Usuario              @relation(fields: [actorUsuarioId], references: [id], map: "fk_evt_usuario")
  evidencia EvidenciaBlockchain?

  @@index([objetoTipo, objetoRef, version], map: "idx_evt_objeto")
  @@index([creadoEn], map: "idx_evt_fecha")
  @@map("evento_trazabilidad")
}

/// Referencia local a la transacción confirmada en Hyperledger Fabric.
model EvidenciaBlockchain {
  id          BigInt               @id @default(autoincrement()) @map("evidencia_id") @db.UnsignedBigInt
  eventoId    String               @unique @map("evento_id") @db.Char(36)
  red         String               @default("fabric-academic") @db.VarChar(80)
  canal       String               @default("academicchannel") @db.VarChar(80)
  chaincode   String               @default("academic-traceability") @db.VarChar(80)
  txId        String               @unique @map("tx_id") @db.VarChar(160)
  blockNumber BigInt?              @map("block_number") @db.UnsignedBigInt
  committedAt DateTime?            @map("committed_at") @db.DateTime(0)
  validacion  ValidacionBlockchain @default(PENDIENTE)

  evento EventoTrazabilidad @relation(fields: [eventoId], references: [id], map: "fk_evidencia_evento")

  @@map("evidencia_blockchain")
}
