# ---------------------------------------------------------------
# Base de datos Off-chain (MySQL 8)
# ---------------------------------------------------------------
DATABASE_URL="mysql://root:CAMBIAR_PASSWORD@localhost:3306/trazabilidad_academica"

# ---------------------------------------------------------------
# Evidencia criptográfica (HMAC-SHA-256)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres. NUNCA versionar el valor real.
# ---------------------------------------------------------------
HMAC_SECRET=

# ---------------------------------------------------------------
# Hyperledger Fabric (Fabric Gateway)
# Las rutas son relativas a app-next/ o absolutas.
# ---------------------------------------------------------------
FABRIC_CHANNEL_NAME=academicchannel
FABRIC_CHAINCODE_NAME=academic-traceability
FABRIC_MSP_ID=NuevoHorizonteMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.nuevohorizonte.example.com
FABRIC_TLS_CERT_PATH=../fabric-network/organizations/peerOrganizations/nuevohorizonte.example.com/peers/peer0.nuevohorizonte.example.com/tls/ca.crt
FABRIC_CERT_PATH=../fabric-network/organizations/peerOrganizations/nuevohorizonte.example.com/users/User1@nuevohorizonte.example.com/msp/signcerts
FABRIC_PRIVATE_KEY_PATH=../fabric-network/organizations/peerOrganizations/nuevohorizonte.example.com/users/User1@nuevohorizonte.example.com/msp/keystore

# ---------------------------------------------------------------
# Actor seudónimo que firma las operaciones desde los scripts
# ---------------------------------------------------------------
ACTOR_REFERENCE=ADM-PSE-001
ACTOR_ROLE=ADMINISTRADOR

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
