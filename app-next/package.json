{
  "name": "trazabilidad-academica-app",
  "version": "0.3.0",
  "private": true,
  "description": "Prototipo de trazabilidad microcurricular - I.E. Nuevo Horizonte (Hito 3)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "cross-env RUN_INTEGRATION=1 jest tests/integration --runInBand",
    "seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "check": "tsx --conditions=react-server scripts/checkInfrastructure.ts",
    "record": "tsx --conditions=react-server scripts/registerAcademicRecord.ts",
    "verify": "tsx --conditions=react-server scripts/verifyAcademicRecord.ts",
    "trace": "tsx --conditions=react-server scripts/queryTraceability.ts",
    "rectify": "tsx --conditions=react-server scripts/rectifyAcademicRecord.ts",
    "tamper": "tsx --conditions=react-server scripts/simulateTampering.ts",
    "demo:evidence": "tsx --conditions=react-server scripts/demoEvidence.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@hyperledger/fabric-gateway": "^1.7.1",
    "@prisma/client": "^6.16.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.0.0",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
